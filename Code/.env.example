# Server configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000

# Database credentials (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=computer_shop_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# Security & Authentication
JWT_SECRET=super_secret_jwt_token_key_with_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Default Admin Seed Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123!

# SePay VietQR Payment Gateway (same pattern as SePay integration)
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NAME=COMPUTER SHOP VN
SEPAY_QR_TEMPLATE=compact
SEPAY_WEBHOOK_API_KEY=change_me_sepay_webhook_api_key_at_least_24_chars
# Optional: SePay User API v2 token for automatic polling/reconciliation fallback on localhost
SEPAY_API_TOKEN=
SEPAY_BANK_ACCOUNT_ID=

# Order & Payment Settings
ORDER_PREFIX=CSORDER
ORDER_EXPIRE_MINUTES=30
PAYMENT_CALLBACK_SECRET=change_me_hmac_callback_secret_at_least_24_chars
PAYMENT_DEMO_MODE=true
