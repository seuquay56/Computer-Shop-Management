              "raw": "{\n  \"name\": \"Intel Core i7-14700K\",\n  \"brand\": \"Intel\",\n  \"categoryId\": 1,\n  \"description\": \"CPU thế hệ 14 Raptor Lake Refresh 20 nhân 28 luồng.\",\n  \"variants\": [\n    {\n      \"sku\": \"CPU-INTEL-14700K-BOX\",\n      \"price\": 10890000,\n      \"stockQuantity\": 10,\n      \"lowStockThreshold\": 5\n    }\n  ],\n  \"specs\": [\n    {\n      \"specName\": \"Socket\",\n      \"specValue\": \"LGA1700\"\n    },\n    {\n      \"specName\": \"Cores\",\n      \"specValue\": \"20 Cores\"\n    },\n    {\n      \"specName\": \"TDP\",\n      \"specValue\": \"125W\"\n    }\n  ]\n}"
