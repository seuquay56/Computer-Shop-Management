            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Staff\"\n}"
            },
            "url": "{{baseUrl}}/users/{{sampleUserId}}/role"
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [
